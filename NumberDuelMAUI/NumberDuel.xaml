<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="NumberDuelMAUI.NumberDuel">
    <ContentPage.Resources>
        <Style TargetType="Label" x:Key="Label">
            <Setter Property="BackgroundColor" Value="AliceBlue"/>
            <Setter Property="HeightRequest" Value="100"/>
            <Setter Property="WidthRequest" Value="200"/>

        </Style>

        <Style TargetType="Border" x:Key="LabelBorder">
            <Setter Property="Margin" Value="20"/>
            <Setter Property="HorizontalOptions" Value="Center"/>
            <Setter Property="VerticalOptions" Value="End"/>
        </Style>

        <Style TargetType="Button" x:Key="NumButtons">            
            <Setter Property="TextColor" Value="Black"/>
            <Setter Property="HeightRequest" Value="75"/>
            <Setter Property="WidthRequest" Value="100"/>
            <Setter Property="CornerRadius" Value="-30"/>
            <Setter Property="Text" Value="{Binding Num}" />
            <Setter Property="IsEnabled" Value="{Binding Enabled}" />
            <Setter Property="BackgroundColor" Value="{Binding BackColorMaui}" />
        </Style>

        <Style TargetType="Border" x:Key="NumBorder">
            <Setter Property="Padding" Value="3"/>
        </Style>

    </ContentPage.Resources>


    <ScrollView>
        <VerticalStackLayout>
            <Grid ColumnDefinitions="*,*,*" RowDefinitions="*,*,*,3*" Margin="10">
                <Border Stroke="Black" StrokeThickness="3" Padding="3" HorizontalOptions="Start" Margin="10">
                    <Button x:Name="btnStart" Grid.Column="1" Grid.Row="0" Text="Start" Clicked="StartBtn_Clicked"
                        BackgroundColor="Black" TextColor="White" HeightRequest="75" WidthRequest="180" FontSize="30"/>
                </Border>

                <RadioButton x:Name="rbn2Player" Content="2 Player" Grid.Column="1" Grid.Row="0" HorizontalOptions="Center" VerticalOptions="Start"/>
                <RadioButton x:Name="rbnCompPlay" Content="Play Against Computer" Grid.Column="2" Grid.Row="0" VerticalOptions="Start"/>

                <Border Style="{StaticResource Key=LabelBorder}" Grid.Column="0" Grid.Row="2">
                    <Label x:Name="lblGameStat" Style="{StaticResource Key=Label}"  Grid.Column="0" Grid.Row="2" Text="{Binding GameStatusDescription}"/>
                </Border>

                <Border Style="{StaticResource Key=LabelBorder}" Grid.Column="1" Grid.Row="2">
                    <Label x:Name="lblNumPicked" Style="{StaticResource Key=Label}" Grid.Column="1" Grid.Row="2" Text="{Binding NumberPickedDescription}"/>
                </Border>

                <Border Style="{StaticResource Key=LabelBorder}" Grid.Column="2" Grid.Row="2">
                    <Label x:Name="lblRule" Style="{StaticResource Key=Label}"
                       Text="All numbers picked must be either a multiple or a factor of the number picked previously" 
                       VerticalTextAlignment="Center" Grid.Column="2" Grid.Row="2" HorizontalTextAlignment="Center"/>
                </Border>
                <AbsoluteLayout Grid.Column="0" Grid.ColumnSpan="3" Grid.Row="3" VerticalOptions="Center" HorizontalOptions="Center">

                    <Border Style="{StaticResource Key=NumBorder}" AbsoluteLayout.LayoutBounds="50,30">
                        <Button x:Name="btn1" Style="{StaticResource Key=NumButtons}" BindingContext="{Binding Btns[0]}" AbsoluteLayout.LayoutBounds="50,30" Clicked="btn_Clicked" />
                    </Border>

                    <Border Style="{StaticResource Key=NumBorder}" AbsoluteLayout.LayoutBounds="180,120">
                        <Button x:Name="btn2" Style="{StaticResource Key=NumButtons}" BindingContext="{Binding Btns[1]}" AbsoluteLayout.LayoutBounds="185,130" Clicked="btn_Clicked"/>
                    </Border>

                    <Border Style="{StaticResource Key=NumBorder}" AbsoluteLayout.LayoutBounds="30,210">
                        <Button x:Name="btn3" Style="{StaticResource Key=NumButtons}" BindingContext="{Binding Btns[2]}" AbsoluteLayout.LayoutBounds="30,210" Clicked="btn_Clicked"/>
                    </Border>

                    <Border Style="{StaticResource Key=NumBorder}" AbsoluteLayout.LayoutBounds="170,300">
                        <Button x:Name="btn4" Style="{StaticResource Key=NumButtons}" BindingContext="{Binding Btns[3]}" AbsoluteLayout.LayoutBounds="170,300" Clicked="btn_Clicked"/>
                    </Border>

                    <Border Style="{StaticResource Key=NumBorder}" AbsoluteLayout.LayoutBounds="400,10">
                        <Button x:Name="btn5" Style="{StaticResource Key=NumButtons}" BindingContext="{Binding Btns[4]}" AbsoluteLayout.LayoutBounds="400,10" Clicked="btn_Clicked"/>
                    </Border>

                    <Border Style="{StaticResource Key=NumBorder}" AbsoluteLayout.LayoutBounds="325,200">
                        <Button x:Name="btn6" Style="{StaticResource Key=NumButtons}" BindingContext="{Binding Btns[5]}" AbsoluteLayout.LayoutBounds="325,200" Clicked="btn_Clicked"/>
                    </Border>

                    <Border Style="{StaticResource Key=NumBorder}" AbsoluteLayout.LayoutBounds="450,290">
                        <Button x:Name="btn7" Style="{StaticResource Key=NumButtons}" BindingContext="{Binding Btns[6]}" AbsoluteLayout.LayoutBounds="450,310" Clicked="btn_Clicked"/>
                    </Border>

                    <Border Style="{StaticResource Key=NumBorder}" AbsoluteLayout.LayoutBounds="530,150">
                        <Button x:Name="btn8" Style="{StaticResource Key=NumButtons}" BindingContext="{Binding Btns[7]}" AbsoluteLayout.LayoutBounds="530,150" Clicked="btn_Clicked"/>
                    </Border>

                    <Border Style="{StaticResource Key=NumBorder}" AbsoluteLayout.LayoutBounds="660,310">
                        <Button x:Name="btn9" Style="{StaticResource Key=NumButtons}" BindingContext="{Binding Btns[8]}" AbsoluteLayout.LayoutBounds="600,310" Clicked="btn_Clicked"/>
                    </Border>

                    <Border Style="{StaticResource Key=NumBorder}" AbsoluteLayout.LayoutBounds="675,50">
                        <Button x:Name="btn10" Style="{StaticResource Key=NumButtons}" BindingContext="{Binding Btns[9]}" AbsoluteLayout.LayoutBounds="675,50" Clicked="btn_Clicked"/>
                    </Border>

                    <Border Style="{StaticResource Key=NumBorder}" AbsoluteLayout.LayoutBounds="770,200">
                        <Button x:Name="btn11" Style="{StaticResource Key=NumButtons}" BindingContext="{Binding Btns[10]}" AbsoluteLayout.LayoutBounds="770,200" Clicked="btn_Clicked"/>
                    </Border>

                    <Border Style="{StaticResource Key=NumBorder}" AbsoluteLayout.LayoutBounds="940,20">
                        <Button x:Name="btn12" Style="{StaticResource Key=NumButtons}" BindingContext="{Binding Btns[11]}" AbsoluteLayout.LayoutBounds="940,20" Clicked="btn_Clicked"/>
                    </Border>

                    <Border Style="{StaticResource Key=NumBorder}" AbsoluteLayout.LayoutBounds="950,150">
                        <Button x:Name="btn13" Style="{StaticResource Key=NumButtons}" BindingContext="{Binding Btns[12]}" AbsoluteLayout.LayoutBounds="950,150" Clicked="btn_Clicked"/>
                    </Border>

                    <Border Style="{StaticResource Key=NumBorder}" AbsoluteLayout.LayoutBounds="910,295">
                        <Button x:Name="btn14" Style="{StaticResource Key=NumButtons}" BindingContext="{Binding Btns[13]}" AbsoluteLayout.LayoutBounds="910,295" Clicked="btn_Clicked"/>
                    </Border>

                    <Border Style="{StaticResource Key=NumBorder}" AbsoluteLayout.LayoutBounds="1120,100">
                        <Button x:Name="btn15" Style="{StaticResource Key=NumButtons}" BindingContext="{Binding Btns[14]}" AbsoluteLayout.LayoutBounds="1120,100" Clicked="btn_Clicked"/>

                    </Border>

                    <Border Style="{StaticResource Key=NumBorder}" AbsoluteLayout.LayoutBounds="1100,240">
                        <Button x:Name="btn16" Style="{StaticResource Key=NumButtons}" BindingContext="{Binding Btns[15]}" AbsoluteLayout.LayoutBounds="1100,240" Clicked="btn_Clicked"/>
                    </Border>

                </AbsoluteLayout>



            </Grid>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
